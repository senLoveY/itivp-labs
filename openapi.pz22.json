{
  "openapi": "3.0.0",
  "info": {
    "title": "REST API микроблога",
    "version": "1.0.0",
    "description": "Пользователи, публикации и комментарии в PostgreSQL. Создайте пользователя через POST /api/users, получите token через POST /auth/login и введите его в Authorize. PUT заменяет все изменяемые поля; PATCH принимает непустой набор полей. "
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "Запись не найдена."
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "example": "user"
          },
          "isBanned": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Tweet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "author": {
            "type": "string",
            "description": "Email автора (сохранена структура ПЗ №1)."
          },
          "content": {
            "type": "string"
          },
          "hashtags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "likesCount": {
            "type": "integer",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "authorId": {
            "type": "integer",
            "minimum": 1
          },
          "tweetId": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "writeOnly": true,
            "description": "8–72 символа: A–Z, a–z, цифра и @$!%*?&. Роль назначает сервер."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "writeOnly": true,
            "description": "8–72 символа: A–Z, a–z, цифра и @$!%*?&. Роль назначает сервер."
          }
        },
        "minProperties": 1
      },
      "TweetWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "hashtags": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "authorId": {
            "type": "integer",
            "minimum": 1,
            "description": "ID пользователя; сервер сохраняет его email в поле author."
          }
        },
        "required": [
          "content",
          "hashtags",
          "authorId"
        ]
      },
      "TweetPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "hashtags": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "authorId": {
            "type": "integer",
            "minimum": 1,
            "description": "ID пользователя; сервер сохраняет его email в поле author."
          }
        },
        "minProperties": 1
      },
      "CommentWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "authorId": {
            "type": "integer",
            "minimum": 1
          },
          "tweetId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "text",
          "authorId",
          "tweetId"
        ]
      },
      "CommentPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "authorId": {
            "type": "integer",
            "minimum": 1
          },
          "tweetId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "minProperties": 1
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "400": {
        "description": "Некорректные данные, ID или JSON.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Отсутствует или недействителен JWT.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "403": {
        "description": "Недостаточно прав или пользователь заблокирован.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "Запись не найдена.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "Конфликт email или связанных записей.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "413": {
        "description": "Тело запроса превышает 100 КБ.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "500": {
        "description": "Ошибка сервера.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/users": {
      "get": {
        "summary": "Получить список: пользователи",
        "tags": [
          "Пользователи"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "post": {
        "summary": "Создать пользователя",
        "tags": [
          "Пользователи"
        ],
        "security": [],
        "responses": {
          "201": {
            "description": "Создано",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Адрес созданного ресурса.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserWrite"
              },
              "example": {
                "email": "demo@example.com",
                "password": "DemoPass!9"
              }
            }
          }
        }
      }
    },
