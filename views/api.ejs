<section id="api-feed" class="feed" hidden>
    <div class="page-title"><h1>Лента</h1><span class="api-hint">Публикации и обсуждения</span></div>
    <p class="api-message" role="status"></p>
    <form id="api-tweet-form" class="compose-form" hidden>
        <label>Что нового?<textarea name="content" rows="3" maxlength="280" placeholder="Поделитесь мыслями" required></textarea></label>
        <label>Теги<input name="hashtags" maxlength="300" placeholder="#учёба #разработка"></label>
        <button type="submit" class="primary">Опубликовать</button>
    </form>
    <div id="api-tweet-list"></div>
</section>
