<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · Микроблог</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= typeof authPage !== 'undefined' && authPage ? 'auth-page' : 'app-page' %>">
    <% if (typeof authPage === 'undefined' || !authPage) { %>
        <header>
            <nav class="app-nav">
                <a class="brand" href="/">Микроблог</a>
                <div id="api-account" aria-label="Аккаунт"></div>
            </nav>
        </header>
    <% } %>
    <main><%- body %></main>
    <script src="/js/api-ui.js" defer></script>
</body>
</html>
